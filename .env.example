# CareBridge Hospital Assistant - Environment Configuration Template

# Database Connection (Render PostgreSQL in production, or SQLite fallback locally)
# Production format: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=postgresql://carebridge_user:carebridge_pass@localhost:5432/carebridge_db

# Security Secrets
SECRET_KEY=generate-a-secure-random-secret-key-for-production
JWT_SECRET_KEY=generate-a-secure-jwt-signing-key

# Environment Mode: development, production, testing
ENVIRONMENT=development

# Port (Render dynamically assigns $PORT; defaults to 5000)
PORT=5000

# CORS Allowed Origins (Comma separated or * for wide access)
CORS_ORIGINS=*

# NLP Confidence Threshold (0.0 to 1.0; default 0.55)
NLP_CONFIDENCE_THRESHOLD=0.55
